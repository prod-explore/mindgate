# Copy to .env next to package.json and fill in.
# The agent refuses to start with the placeholder below. Generate the secret with:  openssl rand -hex 32
# The same value goes into the hub (provider "API key") and into tray/config/tray.yml (agent.secret).

MINDGATE_NODE_SECRET=change-me

# Everything below is optional. The values shown are the defaults unless a comment calls them examples.
# Name of this machine in the hub's panel and in /node/status.
# MINDGATE_NODE_ID=<hostname>
# MINDGATE_NODE_HOST=0.0.0.0
# MINDGATE_NODE_PORT=3001
# LOG_LEVEL=info

# Ollama. The agent adopts a running Ollama; otherwise it starts one (only for a loopback address).
# OLLAMA_PATH is only needed when the binary is not on PATH or in an installer's usual place (the value is an example).
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_PATH=C:\Program Files\Ollama\ollama.exe
# MINDGATE_MANAGE_OLLAMA=true
# MINDGATE_OLLAMA_START_TIMEOUT_MS=30000

# Passed on to an Ollama the agent starts (examples, sensible for a 4 GB card). The agent also reads two of them:
# OLLAMA_CONTEXT_LENGTH caps the context length it reports, OLLAMA_MODELS is where it measures free disk space.
# OLLAMA_CONTEXT_LENGTH=8192
# OLLAMA_KEEP_ALIVE=5m
# OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_MODELS=D:\ollama-models

# Tray app on this machine: it decides whether an automatic shutdown is welcome (someone may be using the PC).
# Leave empty on a headless server: it then shuts down whenever the hub asks and nothing is running.
# MINDGATE_TRAY_URL=http://127.0.0.1:3002
# MINDGATE_SHUTDOWN_DELAY_SECONDS=30
