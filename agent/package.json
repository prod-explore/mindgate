{
  "name": "mindgate-agent",
  "version": "2.0.0",
  "description": "MindGate node agent — lets the hub manage and use the models on a machine with a GPU",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && (tsc --watch --preserveWatchOutput & node --watch dist/index.js)",
    "test": "npm run build && node --test --test-timeout=30000 dist/__tests__/*.test.js",
    "install-service": "node install-service.js",
    "uninstall-service": "node uninstall-service.js"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "node-windows": "^1.0.0-beta.8",
    "typescript": "^5.8.3"
  }
}
