# Copy to .env and fill in. The hub refuses to start with the placeholders below.
# Generate each secret with:  openssl rand -hex 32

# Encrypts the provider API keys stored in the database. Keep a copy somewhere safe, apart from database backups:
# without it the saved provider keys cannot be read (you would have to enter them again).
MINDGATE_MASTER_KEY=change-me

# Protects /admin: the management API and the panel's sign-in. Different from the master key.
MINDGATE_ADMIN_TOKEN=change-me

# Everything below is optional; these are the defaults.
# MINDGATE_PORT=3000
# MINDGATE_DB=/data/mindgate.db
# MINDGATE_LOG_LEVEL=info

# Time zone in which "a day" and "a month" start for the usage limits of client keys.
# MINDGATE_USAGE_TZ=Europe/Warsaw

# Set to true when a reverse proxy (nginx, Caddy) is in front, so the client's real address is used for login throttling.
# MINDGATE_TRUST_PROXY=false

# Where the built admin panel is, served at /admin/. The Docker image sets this itself; from a checkout it is panel/dist
# (cd panel && npm ci && npm run build). Empty turns the panel off and leaves only the API.
# MINDGATE_PANEL_DIR=

# Longest wait line for a provider that handles one request at a time, and how long a request may wait in it (0 = forever).
# MINDGATE_QUEUE_MAX=100
# MINDGATE_QUEUE_TIMEOUT_MS=0

# How long the request log (no prompt text, only who/what/how long) is kept.
# MINDGATE_LOG_RETENTION_DAYS=30
