# Copy to .env and fill in. The hub refuses to start with the placeholders below.
# Generate each secret with:  openssl rand -hex 32

# Encrypts the provider API keys stored in the database. Keep a copy somewhere safe, apart from database backups:
# without it the saved provider keys cannot be read (you would have to enter them again).
MINDGATE_MASTER_KEY=change-me

# Protects /admin: the management API and the panel's sign-in. Different from the master key.
MINDGATE_ADMIN_TOKEN=change-me

# Everything below is optional; the values shown are the defaults.
# MINDGATE_PORT=3000
# MINDGATE_DB=/data/mindgate.db
# MINDGATE_LOG_LEVEL=info

# Time zone in which "a day" and "a month" start for the usage limits of client keys (an IANA name such as Europe/Warsaw).
# MINDGATE_USAGE_TZ=UTC

# Set to true when a reverse proxy (nginx, Caddy) is in front, so the client's real address is used for login throttling.
# MINDGATE_TRUST_PROXY=false

# Where the built admin panel is, served at /admin/. The Docker image sets this itself; from a checkout it is panel/dist
# (cd panel && npm ci && npm run build). Empty turns the panel off and leaves only the API.
# MINDGATE_PANEL_DIR=

# Longest wait line for a provider that handles one request at a time, and how long a request may wait in it (0 = forever).
# MINDGATE_QUEUE_MAX=100
# MINDGATE_QUEUE_TIMEOUT_MS=0

# When a provider says "not now" (429 rate limit, 503 overload, no answer in time) before any of the answer has gone out,
# the hub tries the same model again, waiting as long as the provider asks (its Retry-After, or the retryDelay in a Google
# error), else 1s, 2s, 4s... This is how long after the first failure it keeps trying (0 = never retry). A used-up daily
# quota is not retried.
# MINDGATE_UPSTREAM_RETRY_MS=45000

# A provider with "rpm" and/or "tpm" set (requests / prompt tokens per minute) makes requests wait for their turn. A request
# waits at most MINDGATE_QUEUE_TIMEOUT_MS when that is set, else this long (0 = forever), then fails with 503 pacing_timeout.
# MINDGATE_PACING_MAX_WAIT_MS=120000

# How long the request log (no prompt text, only who/what/how long) is kept.
# MINDGATE_LOG_RETENTION_DAYS=30

# Wake-on-LAN relay, off by default (the values below are examples). Needed when the hub runs in Docker (on a bridge
# network) and a machine that sleeps is on your LAN: a container on a bridge cannot broadcast onto the LAN, so a small
# second container on the host's network sends the packet.
# Turn the container on with the profile, give both sides the same token (openssl rand -hex 24), bind the relay to the
# address of the Docker network's gateway (docker network inspect mindgate_net, "Gateway") and point the hub at it.
# In the panel, set the machine's "broadcast" to the LAN's broadcast address (for example 192.168.1.255), not its own IP.
# COMPOSE_PROFILES=wol
# MINDGATE_WOL_RELAY_TOKEN=change-me
# MINDGATE_WOL_RELAY_BIND=172.18.0.1
# MINDGATE_WOL_RELAY_URL=http://172.18.0.1:7009
