{
  "name": "mindgate-hub",
  "version": "2.0.0",
  "description": "MindGate hub — one OpenAI-compatible API in front of local nodes, OpenRouter, Gemini, Anthropic and anything else that speaks HTTP",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mindgate": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsc && (tsc --watch --preserveWatchOutput & node --watch --env-file-if-exists=.env dist/index.js)",
    "cli": "node --env-file-if-exists=.env dist/cli.js",
    "test": "npm run build && node --test dist/__tests__/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.3.3",
    "pino": "^10.4.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "typescript": "^5.8.3"
  }
}
